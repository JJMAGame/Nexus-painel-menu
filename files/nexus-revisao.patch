+    public void criaInquilinoComoContaPadrao() {
+        String saida = rodar("1", "Maria", "maria@nexus.com", "abc12345", "1");
+
+        List<Usuario> lidos = JsonUtil.ler(usuarios(), Usuario.class);
+        assertEquals(1, lidos.size());
+        assertTrue(lidos.get(0) instanceof Inquilino);
+        assertTrue(saida, saida.contains("Tipo: Inquilino"));
+    }
+
+    @Test
+    public void qualquerRespostaDiferenteDe2ViraInquilino() {
+        rodar("1", "Maria", "maria@nexus.com", "abc12345", "");
+        assertTrue(JsonUtil.ler(usuarios(), Usuario.class).get(0) instanceof Inquilino);
+    }
+
+    @Test
+    public void criaAdministrador() {
+        String saida = rodar("1", "Chefe", "chefe@nexus.com", "abc12345", "2");
+
+        assertTrue(JsonUtil.ler(usuarios(), Usuario.class).get(0) instanceof Admin);
+        assertTrue(saida, saida.contains("Tipo: Administrador"));
+    }
+
+    @Test
+    public void novoUsuarioNaoApagaOsQueJaExistem() {
+        rodar("1", "Um", "um@nexus.com", "abc12345", "1");
+        rodar("1", "Dois", "dois@nexus.com", "abc12345", "2");
+
+        List<Usuario> lidos = JsonUtil.ler(usuarios(), Usuario.class);
+        assertEquals(2, lidos.size());
+        assertEquals("um@nexus.com", lidos.get(0).getEmail());
+        assertEquals("dois@nexus.com", lidos.get(1).getEmail());
+    }
+
+    @Test
+    public void emailRepetidoERecusadoMesmoComMaiusculas() {
+        rodar("1", "Um", "um@nexus.com", "abc12345", "1");
+        String saida = rodar("1", "Outro", "UM@Nexus.com", "abc12345", "1");
+
+        assertEquals(1, JsonUtil.ler(usuarios(), Usuario.class).size());
+        assertTrue(saida, saida.contains("já existe"));
+    }
+
+    @Test
+    public void senhaCurtaNaoCriaOBanco() {
+        String saida = rodar("1", "Maria", "maria@nexus.com", "123", "1");
+
+        assertFalse(new File(usuarios()).exists());
+        assertTrue(saida, saida.contains("Senha deve ter entre 6 e 12 caracteres"));
+    }
+
+    @Test
+    public void criaImovel() {
+        String saida = rodar("2", "Casa de José", "R. Ubiratã, 226 - Recife - PE");
+
+        List<Imovel> lidos = JsonUtil.ler(imoveis(), Imovel.class);
+        assertEquals(1, lidos.size());
+        assertEquals("Casa de José", lidos.get(0).getNome());
+        assertTrue(saida, saida.contains("Total de imóveis no sistema: 1"));
+    }
+
+    @Test
+    public void imovelSemLocalizacaoNaoEGravado() {
+        String saida = rodar("2", "Casa", "");
+
+        assertFalse(new File(imoveis()).exists());
+        assertTrue(saida, saida.contains("localização"));
+    }
+
+    @Test
+    public void opcaoInvalidaNaoGeraNada() {
+        String saida = rodar("9");
+
+        assertFalse(new File(usuarios()).exists());
+        assertFalse(new File(imoveis()).exists());
+        assertTrue(saida, saida.contains("Opção inválida"));
+    }
+}
diff --git a/sistema-usuarios/src/test/java/com/nexusmaven/JsonUtilTest.java b/sistema-usuarios/src/test/java/com/nexusmaven/JsonUtilTest.java
new file mode 100644
index 0000000..13eedc4
--- /dev/null
+++ b/sistema-usuarios/src/test/java/com/nexusmaven/JsonUtilTest.java
@@ -0,0 +1,153 @@
+package com.nexusmaven;
+
+import static java.nio.charset.StandardCharsets.ISO_8859_1;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+/** Testa a leitura e a gravação dos "bancos de dados" JSON, sempre em arquivos temporários. */
+public class JsonUtilTest {
+
+    @Rule
+    public TemporaryFolder pasta = new TemporaryFolder();
+
+    private String caminho(String nome) {
+        return new File(pasta.getRoot(), nome).getPath();
+    }
+
+    @Test
+    public void arquivoInexistenteRetornaListaVazia() {
+        assertTrue(JsonUtil.ler(caminho("nao-existe.json"), Usuario.class).isEmpty());
+    }
+
+    @Test
+    public void arquivoVazioRetornaListaVazia() throws IOException {
+        File vazio = pasta.newFile("vazio.json");
+        assertTrue(JsonUtil.ler(vazio.getPath(), Usuario.class).isEmpty());
+    }
+
+    @Test
+    public void usuariosSobrevivemAoRoundTripComOTipoCorreto() {
+        List<Usuario> origem = new ArrayList<>();
+        origem.add(new Admin("Ana", "ana@nexus.com", "senha123"));
+        origem.add(new Inquilino("João", "joao@nexus.com", "senha456"));
+        String arquivo = caminho("usuarios.json");
+
+        JsonUtil.salvar(arquivo, origem);
+        List<Usuario> lidos = JsonUtil.ler(arquivo, Usuario.class);
+
+        assertEquals(2, lidos.size());
+        assertTrue(lidos.get(0) instanceof Admin);
+        assertTrue(lidos.get(1) instanceof Inquilino);
+        assertEquals("ana@nexus.com", lidos.get(0).getEmail());
+        assertEquals("João", lidos.get(1).getNome());
+        assertTrue(lidos.get(1).autenticar("JOAO@nexus.com", "senha456"));
+    }
+
+    @Test
+    public void registroSemTipoViraInquilino() throws IOException {
+        File antigo = pasta.newFile("antigo.json");
+        Files.writeString(antigo.toPath(),
+                "[{\"nome\":\"Carlos\",\"email\":\"carlos@hotmail.com\",\"senha\":\"123456\"}]", UTF_8);
+
+        List<Usuario> lidos = JsonUtil.ler(antigo.getPath(), Usuario.class);
+
+        assertEquals(1, lidos.size());
+        assertTrue(lidos.get(0) instanceof Inquilino);
+    }
+
+    @Test
+    public void tipoDesconhecidoDaErroClaroEmVezDeStackOverflow() throws IOException {
+        File arquivo = pasta.newFile("tipo-estranho.json");
+        Files.writeString(arquivo.toPath(),
+                "[{\"tipo\":\"visitante\",\"nome\":\"X\",\"email\":\"x@x.com\",\"senha\":\"123456\"}]", UTF_8);
+        try {
+            JsonUtil.ler(arquivo.getPath(), Usuario.class);
+            fail("Era esperado um erro para o tipo desconhecido");
+        } catch (IllegalStateException e) {
+            assertTrue(e.getMessage(), e.getMessage().contains("visitante"));
+        }
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void jsonComSintaxeQuebradaDaErroClaro() throws IOException {
+        File quebrado = pasta.newFile("quebrado.json");
+        Files.writeString(quebrado.toPath(), "[{\"nome\": ", UTF_8);
+        JsonUtil.ler(quebrado.getPath(), Usuario.class);
+    }
+
+    @Test
+    public void acentosEApostrofosSaoGravadosEmUtf8EVoltamIntactos() throws IOException {
+        List<Imovel> origem = List.of(
+                new Imovel("Casa de José", "R. Ubiratã, 226 - Alto José do Pinho, Recife - PE"),
+                new Imovel("D'Ávila & Cia", "Av. Ali, 22"));
+        String arquivo = caminho("imoveis.json");
+
+        JsonUtil.salvar(arquivo, origem);
+
+        // A decodificação estrita falha se o arquivo não for UTF-8 válido
+        String texto = UTF_8.newDecoder().decode(ByteBuffer.wrap(Files.readAllBytes(Path.of(arquivo)))).toString();
+        assertTrue(texto.contains("José"));
+        assertTrue(texto.contains("Ubiratã"));
+        assertTrue("& e ' não devem virar \\u0026 / \\u0027", texto.contains("D'Ávila & Cia"));
+
+        List<Imovel> lidos = JsonUtil.ler(arquivo, Imovel.class);
+        assertEquals("Casa de José", lidos.get(0).getNome());
+        assertEquals("D'Ávila & Cia", lidos.get(1).getNome());
+    }
+
+    @Test
+    public void arquivoForaDeUtf8ERecusadoEmVezDeTrocarOsAcentosPorInterrogacao() throws IOException {
+        File antigo = pasta.newFile("latin1.json");
+        Files.write(antigo.toPath(), "[{\"nome\":\"José\",\"localizacao\":\"Rua A\"}]".getBytes(ISO_8859_1));
+        try {
+            JsonUtil.ler(antigo.getPath(), Imovel.class);
+            fail("Era esperado um erro para arquivo fora de UTF-8");
+        } catch (UncheckedIOException e) {
+            assertTrue(e.getMessage(), e.getMessage().contains("UTF-8"));
+        }
+    }
+
+    @Test
+    public void imovelAntigoComChaveLnomeContinuaLegivelEESalvaComNome() throws IOException {
+        File antigo = pasta.newFile("imoveis-antigo.json");
+        Files.writeString(antigo.toPath(), "[{\"lnome\":\"Casa A\",\"localizacao\":\"Rua B\"}]", UTF_8);
+
+        List<Imovel> lidos = JsonUtil.ler(antigo.getPath(), Imovel.class);
+        assertEquals("Casa A", lidos.get(0).getNome());
+
+        JsonUtil.salvar(antigo.getPath(), lidos);
+        String texto = Files.readString(antigo.toPath(), UTF_8);
+        assertTrue(texto.contains("\"nome\""));
+        assertFalse(texto.contains("lnome"));
+    }
+
+    @Test
+    public void salvarSubstituiOConteudoAnteriorENaoDeixaTemporarioParaTras() {
+        String arquivo = caminho("u.json");
+        JsonUtil.salvar(arquivo, List.of(new Inquilino("Um", "um@um.com", "123456"),
+                                          new Inquilino("Dois", "dois@dois.com", "123456")));
+        JsonUtil.salvar(arquivo, List.of(new Inquilino("Zé", "ze@ze.com", "123456")));
+
+        List<Usuario> lidos = JsonUtil.ler(arquivo, Usuario.class);
+        assertEquals(1, lidos.size());
+        assertEquals("Zé", lidos.get(0).getNome());
+        assertArrayEquals(new String[] {"u.json"}, pasta.getRoot().list());
+    }
+}
diff --git a/sistema-usuarios/src/test/java/com/nexusmaven/LoginEMenusTest.java b/sistema-usuarios/src/test/java/com/nexusmaven/LoginEMenusTest.java
new file mode 100644
index 0000000..a1905f4
--- /dev/null
+++ b/sistema-usuarios/src/test/java/com/nexusmaven/LoginEMenusTest.java
@@ -0,0 +1,141 @@
+package com.nexusmaven;
+
+import static com.nexusmaven.ApoioDeTestes.capturarSaida;
+import static com.nexusmaven.ApoioDeTestes.entrada;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.io.File;
+import java.util.List;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+/** Login (Main) e menus (Admin e Inquilino), com teclado simulado e banco temporário. */
+public class LoginEMenusTest {
+
+    @Rule
+    public TemporaryFolder pasta = new TemporaryFolder();
+
+    private String banco;
+
+    @Before
+    public void criarBanco() {
+        banco = new File(pasta.getRoot(), "usuarios.json").getPath();
+        JsonUtil.salvar(banco, List.of(
+                new Admin("Chefe", "admin@nexus.com", "admin123"),
+                new Inquilino("João", "joao@nexus.com", "comum123")));
+    }
+
+    private String loginComo(String... digitado) {
+        return capturarSaida(() -> Main.executar(entrada(digitado), banco));
+    }
+
+    // ===== Login =====
+
+    @Test
+    public void loginDeInquilinoAbreOMenuDoInquilino() {
+        String saida = loginComo("joao@nexus.com", "comum123", "0");
+        assertTrue(saida, saida.contains("Login realizado com sucesso! Bem-vindo, João."));
+        assertTrue(saida, saida.contains("MENU INQUILINO"));
+        assertFalse(saida, saida.contains("MENU ADMIN"));
+    }
+
+    @Test
+    public void loginDeAdminAbreOMenuDoAdmin() {
+        String saida = loginComo("ADMIN@nexus.com", "admin123", "0");
+        assertTrue(saida, saida.contains("MENU ADMIN"));
+        assertFalse(saida, saida.contains("MENU INQUILINO"));
+    }
+
+    @Test
+    public void senhaIncorretaPedeDeNovoEDepoisAceita() {
+        String saida = loginComo("joao@nexus.com", "errada1", "joao@nexus.com", "comum123", "0");
+        assertTrue(saida, saida.contains("Senha incorreta"));
+        assertTrue(saida, saida.contains("Login realizado com sucesso"));
+    }
+
+    @Test
+    public void emailInexistenteEFimDaEntradaEncerramSemTravar() {
+        String saida = loginComo("ninguem@nexus.com", "123456");
+        assertTrue(saida, saida.contains("Email não encontrado"));
+        assertFalse(saida, saida.contains("MENU"));
+    }
+
+    @Test
+    public void bancoVazioAvisaParaRodarOGerarDados() {
+        String vazio = new File(pasta.getRoot(), "nao-existe.json").getPath();
+        String saida = capturarSaida(() -> Main.executar(entrada("a", "b"), vazio));
+        assertTrue(saida, saida.contains("Nenhum usuário encontrado"));
+    }
+
+    // ===== Menu do inquilino =====
+
+    private String menuInquilino(String... digitado) {
+        Inquilino inquilino = new Inquilino("João", "joao@nexus.com", "comum123");
+        return capturarSaida(() -> inquilino.abrirMenu(entrada(digitado)));
+    }
+
+    @Test
+    public void inquilinoVeSeusDados() {
+        String saida = menuInquilino("1", "0");
+        assertTrue(saida, saida.contains("Nome: João"));
+        assertTrue(saida, saida.contains("Email: joao@nexus.com"));
+    }
+
+    @Test
+    public void opcoesAindaNaoImplementadasAvisamEmDesenvolvimento() {
+        String saida = menuInquilino("3", "4", "5", "6", "7", "0");
+        for (String recurso : new String[] {"Meu contrato", "Próximo aluguel", "Extratos", "Documentos", "Notificações"}) {
+            assertTrue(recurso + " / " + saida, saida.contains(recurso + " - funcionalidade em desenvolvimento."));
+        }
+    }
+
+    @Test
+    public void menuDoInquilinoTrataTextoOpcaoInvalidaEFimDaEntrada() {
+        String saida = menuInquilino("abc", "99");   // sem "0": a entrada termina e o menu sai sozinho
+        assertTrue(saida, saida.contains("Por favor, digite um número válido"));
+        assertTrue(saida, saida.contains("Opção inválida"));
+        assertTrue(saida, saida.contains("Saindo do menu do inquilino"));
+    }
+
+    @Test
+    public void listaDeImoveisMostraNomeELocalizacao() {
+        Inquilino inquilino = new Inquilino("João", "joao@nexus.com", "comum123");
+        String saida = capturarSaida(() -> inquilino.exibirImoveis(List.of(
+                new Imovel("Casa de José", "R. Ubiratã, 226"), new Imovel("Apto 301", "Av. Ali, 22"))));
+        assertTrue(saida, saida.contains("1. Casa de José - R. Ubiratã, 226"));
+        assertTrue(saida, saida.contains("2. Apto 301 - Av. Ali, 22"));
+    }
+
+    @Test
+    public void listaDeImoveisVaziaAvisa() {
+        Inquilino inquilino = new Inquilino("João", "joao@nexus.com", "comum123");
+        String saida = capturarSaida(() -> inquilino.exibirImoveis(List.of()));
+        assertTrue(saida, saida.contains("Nenhum imóvel cadastrado."));
+    }
+
+    // ===== Menu do admin =====
+
+    @Test
+    public void menuDoAdminTrataOpcoesESai() {
+        Admin admin = new Admin("Chefe", "admin@nexus.com", "admin123");
+        String saida = capturarSaida(() -> admin.abrirMenu(entrada("2", "x", "7", "0")));
+        assertTrue(saida, saida.contains("Registrar pagamentos - funcionalidade em desenvolvimento."));
+        assertTrue(saida, saida.contains("Por favor, digite um número válido"));
+        assertTrue(saida, saida.contains("Opção inválida"));
+        assertTrue(saida, saida.contains("Saindo do menu admin"));
+    }
+
+    @Test
+    public void adminGeraDadosPeloMenuUsandoOMesmoScannerDoPrograma() {
+        // Opção 1 do menu chama o GerarDados; depois o menu continua lendo do mesmo teclado.
+        // Só a opção inválida é digitada dentro do GerarDados, então nenhum banco é alterado.
+        Admin admin = new Admin("Chefe", "admin@nexus.com", "admin123");
+        String saida = capturarSaida(() -> admin.abrirMenu(entrada("1", "9", "0")));
+        assertTrue(saida, saida.contains("Nenhum dado foi gerado"));   // GerarDados recebeu o "9"
+        assertTrue(saida, saida.contains("Saindo do menu admin"));     // e o menu ainda leu o "0"
+    }
+}
diff --git a/sistema-usuarios/src/test/java/com/nexusmaven/UsuarioEImovelTest.java b/sistema-usuarios/src/test/java/com/nexusmaven/UsuarioEImovelTest.java
