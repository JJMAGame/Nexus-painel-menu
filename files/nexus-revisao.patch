+package com.nexusmaven;
+
+import java.util.List;
+import java.util.Scanner;
+
+/**
+ * Esqueleto do painel do inquilino.
+ *
+ * As opções seguem as telas do protótipo navegável (Logs/Nexus · Protótipo · Fundação Manoel Cruz.html):
+ * Meu perfil, Meu contrato, Próximo aluguel (pagar com Pix), Extratos, Documentos e Notificações.
+ * Hoje só "Ver meus dados" e "Ver imóveis" funcionam; o resto são métodos vazios com TODO.
+ *
+ * TODO: ligar o inquilino a um imóvel/contrato (ex.: campo "imovel" no usuarios.json).
+ *       Sem esse vínculo, "Meu contrato", "Próximo aluguel" e "Extratos" não têm de onde ler os dados.
+ */
+public class Inquilino extends Usuario {
+    private final String tipo = "inquilino";
+
+    public Inquilino() {} // Obrigatório para o Gson
+
+    public Inquilino(String nome, String email, String senha) {
+        super(nome, email, senha);
+    }
+
+    public String getTipo() { return tipo; }
+
+    // ===== MENU =====
+    public void abrirMenu(Scanner scanner) {
+        int opcao = -1;
+
+        while (opcao != 0) {
+            exibirMenu();
+
+            opcao = EntradaConsole.lerOpcao(scanner);
+            if (opcao == EntradaConsole.OPCAO_INVALIDA) {
+                System.out.println("❌ Por favor, digite um número válido.");
+                continue;
+            }
+
+            switch (opcao) {
+                case 1 -> verMeusDados();
+                case 2 -> verImoveisDisponiveis();
+                case 3 -> verMeuContrato();
+                case 4 -> verProximoAluguel();
+                case 5 -> verExtratos();
+                case 6 -> verDocumentos();
+                case 7 -> verNotificacoes();
+                case 0 -> System.out.println("👋 Saindo do menu do inquilino...");
+                default -> System.out.println("❌ Opção inválida. Tente novamente.");
+            }
+        }
+    }
+
+    private void exibirMenu() {
+        System.out.println("\n===================================");
+        System.out.println("        MENU INQUILINO - NEXUS     ");
+        System.out.println("===================================");
+        System.out.println("Olá, " + getNome() + "! O que deseja fazer?");
+        System.out.println("1 - Ver meus dados");
+        System.out.println("2 - Ver imóveis disponíveis");
+        System.out.println("3 - Meu contrato");
+        System.out.println("4 - Próximo aluguel");
+        System.out.println("5 - Extratos");
+        System.out.println("6 - Documentos");
+        System.out.println("7 - Notificações");
+        System.out.println("0 - Sair (Logout)");
+        System.out.print("Escolha uma opção: ");
+    }
+
+    // ===== FUNCIONALIDADES =====
+
+    // Pronto
+    private void verMeusDados() {
+        System.out.println("\n--- SEUS DADOS ---");
+        System.out.println("Nome: " + getNome());
+        System.out.println("Email: " + getEmail());
+    }
+
+    // Pronto (lista tudo o que existe em imoveis.json)
+    // TODO: filtrar só os vagos quando o Imovel ganhar um campo de situação (vago/alugado/em atraso).
+    private void verImoveisDisponiveis() {
+        exibirImoveis(JsonUtil.ler(JsonUtil.ARQUIVO_IMOVEIS, Imovel.class));
+    }
+
+    // Separado do método acima para poder ser testado sem depender do imoveis.json real
+    void exibirImoveis(List<Imovel> imoveis) {
+        System.out.println("\n--- IMÓVEIS DISPONÍVEIS ---");
+        if (imoveis.isEmpty()) {
+            System.out.println("Nenhum imóvel cadastrado.");
+            return;
+        }
+        for (int i = 0; i < imoveis.size(); i++) {
+            Imovel imovel = imoveis.get(i);
+            System.out.println((i + 1) + ". " + imovel.getNome() + " - " + imovel.getLocalizacao());
+        }
+    }
+
+    // TODO: mostrar início, término, índice de reajuste (ex.: IGP-M) e situação do contrato.
+    private void verMeuContrato() {
+        emDesenvolvimento("Meu contrato");
+    }
+
+    // TODO: mostrar valor, vencimento e situação (em dia / a vencer / em atraso).
+    //       Depois: opção "Pagar com Pix".
+    private void verProximoAluguel() {
+        emDesenvolvimento("Próximo aluguel");
+    }
+
+    // TODO: listar os pagamentos já feitos.
+    private void verExtratos() {
+        emDesenvolvimento("Extratos");
+    }
+
+    // TODO: documentos enviados pelo inquilino, documentos do imóvel e envio de um novo documento.
+    private void verDocumentos() {
+        emDesenvolvimento("Documentos");
+    }
+
+    // TODO: avisos de vencimento, reajuste e documentos novos.
+    private void verNotificacoes() {
+        emDesenvolvimento("Notificações");
+    }
+
+    private void emDesenvolvimento(String recurso) {
+        System.out.println("🚧 " + recurso + " - funcionalidade em desenvolvimento.");
+    }
+}
